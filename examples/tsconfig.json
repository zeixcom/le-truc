{
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"jsx": "preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"types": ["bun", "node"],
		"paths": {
			"@zeix/le-truc": ["../index.ts"]
		},
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"useUnknownInCatchVariables": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true
	},
	"files": [
		"basic/blogmeta/basic-blogmeta.ts",
		"basic/blogmeta/basic-blogmeta.tsx",
		"basic/counter/basic-counter.ts",
		"basic/counter/basic-counter.tsx",
		"basic/pluralize/basic-pluralize.tsx",
		"context/media/context-media.ts",
		"context/media/context-media.tsx",
		"form/listbox/form-listbox.tsx",
		"form/combobox/form-combobox.tsx",
		"module/carousel/module-carousel.ts",
		"module/carousel/module-carousel.tsx",
		"module/codeblock/module-codeblock.ts",
		"module/codeblock/module-codeblock.tsx",
		"module/catalog/module-catalog.ts",
		"module/catalog/module-catalog.tsx",
		"module/coloreditor/module-coloreditor.ts",
		"module/coloreditor/module-coloreditor.tsx",
		"module/colorinfo/module-colorinfo.ts",
		"module/colorinfo/module-colorinfo.tsx",
		"module/dialog/module-dialog.ts",
		"module/dialog/module-dialog.tsx",
		"module/lazyload/module-lazyload.ts",
		"module/lazyload/module-lazyload.tsx",
		"module/listnav/module-listnav.ts",
		"module/listnav/module-listnav.tsx",
		"module/pagination/module-pagination.ts",
		"module/pagination/module-pagination.tsx",
		"module/scrollarea/module-scrollarea.ts",
		"module/scrollarea/module-scrollarea.tsx",
		"module/splitview/module-splitview.ts",
		"module/splitview/module-splitview.tsx",
		"../server/compiler/frontend/tsx/host-profile.d.ts",
		"../server/generated/components/tsrx-imports.d.ts"
	]
}
