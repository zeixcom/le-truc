exports[`variant sets — front-end parity (§4.3, ADR 0039 s1) basic-counter client module snapshot (structural review, not bytes) 1`] = `
"/**
 * Generated by the Le Truc TSRX compiler (milestone 2) from
 * examples/basic/counter/basic-counter.tsx — DO NOT EDIT. The server half lives in basic-counter.server.ts.
 */
import { asNumber, bindText, defineComponent } from '@zeix/le-truc'
import { createCell } from '@zeix/le-truc'

export type BasicCounterProps = {
	/** Current counter value. Increments on each button click. */
	count: number
}

declare global {
	interface HTMLElementTagNameMap {
		'basic-counter': HTMLElement & BasicCounterProps
	}
}

/**
 * A simple click counter that increments on each button press.
 * Use it for demonstrating reactive property updates — the count
 * increments when the button is activated via mouse or keyboard.
 * The host element should contain a \`<button>\` and a \`<span>\`; the button must
 * be a real \`<button>\` element for keyboard activation to work.
 *
 * @demo {https://zeixcom.github.io/le-truc/examples.html#basic-counter} Interactive preview and usage examples
 **/

export default defineComponent<BasicCounterProps>(
	'basic-counter',
	({ expose, first, on, watch }) => {
		const span = first('span', 'basic-counter: span missing')
		const button = first('button', 'basic-counter: button missing')
		const count = createCell(asNumber()(span.textContent))
		expose({ count: count.get })
		on(button, 'click', () => count.set(count.get() + 1))
		watch(count, bindText(span))
	},
)
"
`;

exports[`variant sets — front-end parity (§4.3, ADR 0039 s1) form-combobox client module snapshot (structural review, not bytes) 1`] = `
"/**
 * Generated by the Le Truc TSRX compiler (milestone 2) from
 * examples/form/combobox/form-combobox.tsx — DO NOT EDIT. The server half lives in form-combobox.server.ts.
 */
import { bindProperty, bindText, defineComponent, formAssociated } from '@zeix/le-truc'
import type { FormAssociatedElement } from '@zeix/le-truc'
import { asString, bindAttribute, createState, defineMethod } from '@zeix/le-truc'

export type FormComboboxOption = {
	value: string
	label: string
}

export type FormComboboxProps = {
	/** Current text input value. Updated on each \`input\` event. */
	value: string
	/** Number of characters in the current value (read-only, derived). */
	readonly length: number
	/** Helper text shown below the input. */
	description: string
	/** Clears the input and dispatches \`input\` and \`change\` events. */
	clear: () => void
}

declare global {
	interface HTMLElementTagNameMap {
		'form-combobox': FormAssociatedElement & FormComboboxProps
	}
}

/**
 * A combobox (searchable select) that combines a text input with a filterable listbox popup.
 * Use it for searchable selection — provides ARIA roles for the combobox pattern,
 * keyboard interaction (type to filter, Escape to close, Enter to select), and focus management.
 * Form participation and validity are via ElementInternals (\`formAssociated()\`).
 *
 * @demo {https://zeixcom.github.io/le-truc/examples.html#form-combobox} Interactive preview and usage examples
 **/

export default defineComponent<FormComboboxProps>(
	'form-combobox',
	({ expose, first, host, on, pass, watch }) => {
		const textbox = first('input:not(form-listbox *)', 'combobox input')
		const button = first('button:not(form-listbox *)')
		const popup = first('.popup', 'listbox popup wrapper')
		const listbox = first('form-listbox', 'combobox listbox')
		const descriptionEl = first('.description')
		const p = first('p[role="alert"]', 'form-combobox: p[role="alert"] missing')
		const showPopup = createState(false)
		expose({
			value: asString(''),
			length: () => host.value.length,
			description: descriptionEl?.textContent ?? '',
			clear: defineMethod(() => {
				host.value = ''
				textbox.value = ''
				textbox.setCustomValidity('')
				textbox.checkValidity()
				textbox.dispatchEvent(new Event('input', { bubbles: true }))
				textbox.dispatchEvent(new Event('change', { bubbles: true }))
				textbox.focus()
			}),
		})
		const isOpen = () =>
		showPopup.get() && (listbox.visibleOptions?.length ?? 0) > 0
		watch(() => String(isOpen()), bindAttribute(textbox, 'aria-expanded'))
		watch(() => !isOpen(), bindAttribute(popup, 'hidden'))
		watch(() => host.value, bindProperty(textbox, 'value'))
		on(textbox, 'input', () => {
			host.value = textbox.value
			textbox.checkValidity()
			host.setCustomValidity(textbox.validationMessage ?? '')
			showPopup.set(true)
		})
		on(textbox, 'keyup', (e: KeyboardEvent) => {
			if (e.key === 'Escape') {
				showPopup.set(false)
				textbox.focus()
			}
			if (e.key === 'Delete') host.clear()
		})
		on(textbox, 'keydown', (e: KeyboardEvent) => {
			if (e.key !== 'ArrowDown') return
			if (e.altKey) showPopup.set(true)
			if (showPopup.get()) listbox.focusFirstOption()
		})
		if (button) {
			watch(() => host.value === '', bindAttribute(button, 'hidden'))
			on(button, 'click', () => host.clear())
		}
		on(popup, 'change', () => {
			textbox.value = listbox.value
			host.value = listbox.value
			textbox.checkValidity()
			host.setCustomValidity(textbox.validationMessage ?? '')
			showPopup.set(false)
			textbox.focus()
		})
		pass(listbox, { filter: { get: () => host.value } })
		if (descriptionEl) {
			watch(() => host.description, bindText(descriptionEl))
		}
		watch(() => host.validationMessage, bindText(p))
	},
	[formAssociated()],
)
"
`;

exports[`variant sets — front-end parity (§4.3, ADR 0039 s1) form-listbox client module snapshot (structural review, not bytes) 1`] = `
"/**
 * Generated by the Le Truc TSRX compiler (milestone 2) from
 * examples/form/listbox/form-listbox.tsx — DO NOT EDIT. The server half lives in form-listbox.server.ts.
 */
import { bindAttribute, defineComponent, each, formAssociated } from '@zeix/le-truc'
import type { FormAssociatedElement } from '@zeix/le-truc'
import { asString, defineMethod } from '@zeix/le-truc'

export type FormListboxOption = {
	value: string
	label: string
}

export type FormListboxProps = {
	/** Currently selected option value. */
	value: string
	/** Filter string used to narrow displayed options. */
	filter: string
	/**
	 * Every option, in document order, regardless of the filter (read-only,
	 * derived). The unfiltered projection of the option buttons this
	 * component owns — module-listnav maps the URL hash onto it instead of
	 * querying inside this component's markup (LT-332).
	 */
	readonly options: FormListboxOption[]
	/**
	 * The options currently passing the filter, in document order (read-only,
	 * derived). Composing parents gate their own UI on this — form-combobox
	 * hides its popup when the list is empty — instead of reaching into the
	 * option buttons this component owns (LT-119).
	 */
	readonly visibleOptions: FormListboxOption[]
	/**
	 * Moves focus to the first option still passing the filter, if any. The
	 * public entry point for a composing parent's "open the popup and step
	 * into it" key handler (LT-120).
	 */
	focusFirstOption: () => void
}

declare global {
	interface HTMLElementTagNameMap {
		'form-listbox': FormAssociatedElement & FormListboxProps
	}
}

/**
 * A filterable listbox of declarative options that integrates with HTML forms.
 * Use it for searchable, single-select option lists — provides ARIA listbox
 * semantics, keyboard navigation (Arrow, Home, End), and form participation
 * via ElementInternals.
 *
 * @demo {https://zeixcom.github.io/le-truc/examples.html#form-listbox} Interactive preview and usage examples
 **/

export default defineComponent<FormListboxProps>(
	'form-listbox',
	({ all, expose, first, host, on, watch }) => {
		const options = all('button[role="option"]', 'form-listbox: button[role="option"] missing')
		const input = first('input')
		const button = first('button.clear')
		const div = first('[role="listbox"]', 'form-listbox: [role="listbox"] missing')
		expose({
			value: asString(''),
			filter: asString(''),
			// Children-are-data (LT-119): the rendered option buttons ARE the
			// option list, so the public projection is read back off them
			// (\`data-value\`/\`data-label\`, the same pair the loop writes) rather
			// than off the server \`options\` arg, which the client half never
			// receives. The arg renders the buttons, the prop reads them back:
			// one site in three roles (LT-332). \`visibleOptions\` repeats the
			// per-option \`hidden\` predicate below; both read \`host.filter\`, so
			// both stay live.
			options: () =>
				all('button[role="option"]')
					.get()
					.map((el: HTMLElement) => ({
						value: el.getAttribute('data-value') ?? '',
						label: el.getAttribute('data-label') ?? '',
					})),
			visibleOptions: () =>
				host.options.filter((option: FormListboxOption) =>
					option.label.toLowerCase().includes(host.filter.toLowerCase()),
				),
			focusFirstOption: defineMethod(() => {
				all('button[role="option"]:not([hidden])').get()[0]?.focus()
			}),
		})
		if (input) {
			on(input, 'input', (e: Event) => ({
				filter: (e.target as HTMLInputElement).value,
			}))
		}
		if (button) {
			watch(() => !host.filter, bindAttribute(button, 'hidden'))
			on(button, 'click', () => ({ filter: '' }))
		}
		on(div, 'keydown', (e: KeyboardEvent) => {
			const { key } = e
			if (!['ArrowUp', 'ArrowDown', 'Home', 'End'].includes(key)) return
			const elements = all('button[role="option"]:not([hidden])').get()
			e.preventDefault()
			e.stopPropagation()
			const current = elements.indexOf(
				document.activeElement as HTMLButtonElement,
			)
			const next =
				key === 'Home'
					? 0
					: key === 'End'
						? elements.length - 1
						: (current + (key === 'ArrowDown' ? 1 : -1) + elements.length) %
							elements.length
			elements[next]?.focus()
		})
		on(div, 'keyup', (e: KeyboardEvent) => {
			if (e.key !== 'Enter') return
			if (document.activeElement instanceof HTMLButtonElement)
				document.activeElement.click()
		})
		each(options, option => {
			const optValue = option.getAttribute('data-value')!
			const optLabel = option.getAttribute('data-label')!
			watch(() => String((() => (host.value === optValue ? 0 : -1))()), bindAttribute(option, 'tabindex'))
			watch(() => String(host.value === optValue), bindAttribute(option, 'aria-selected'))
			watch(() =>
			!optLabel.toLowerCase().includes(host.filter.toLowerCase()), bindAttribute(option, 'hidden'))
			on(option, 'click', () => {
				host.value = optValue
				host.dispatchEvent(new Event('change', { bubbles: true }))
			})
		})
	},
	[formAssociated()],
)
"
`;

exports[`variant sets — front-end parity (§4.3, ADR 0039 s1) module-calctable client module snapshot (structural review, not bytes) 1`] = `
"/**
 * Generated by the Le Truc TSRX compiler (milestone 2) from
 * examples/module/calctable/module-calctable.tsx — DO NOT EDIT. The server half lives in module-calctable.server.ts.
 */
import { asNumber, asString, bindProperty, bindText, defineComponent, reconcile } from '@zeix/le-truc'
import type { ElementFromSelector } from '@zeix/le-truc'
import { createList, createMemo, createStore, type MutableStore } from '@zeix/le-truc'

export type CalcItem = {
	id: string
	description: string
	amount: number
	pricePerUnit: number
}

declare global {
	interface HTMLElementTagNameMap {
		'module-calctable': HTMLElement
	}
}

export default defineComponent(
	'module-calctable',
	({ first, host, on, pass, watch }) => {
		const container = first('tbody', 'module-calctable: tbody missing')
		const entryDescription = first('input.entry-description', 'Add a description input to the entry row.')
		const entryAmount = first('input.entry-amount', 'Add an amount input to the entry row.')
		const entryPrice = first('input.entry-price', 'Add a price-per-unit input to the entry row.')
		const td = first('td.amount-total', 'module-calctable: td.amount-total missing')
		const basicNumber2 = first('basic-number.total-price', 'module-calctable: basic-number.total-price missing')
		const MIN_AMOUNT = 0
		const MAX_AMOUNT = 100
		const MIN_PRICE = 0
		const MAX_PRICE = 1000
		const clamp = (value: number, min: number, max: number): number =>
		Math.min(max, Math.max(min, value))
		const items = createList<CalcItem, MutableStore<CalcItem>>([...container.children].filter(el => el.hasAttribute('data-key')).map((el): CalcItem => ({
			id: asString()(el.getAttribute('data-key')),
			description: asString()(el.querySelector<ElementFromSelector<'input[type="text"]'>>('input[type="text"]')?.value),
			amount: asNumber()(el.querySelector<ElementFromSelector<'input.amount'>>('input.amount')?.value),
			pricePerUnit: asNumber()(el.querySelector<ElementFromSelector<'input.price-per-unit'>>('input.price-per-unit')?.value),
		})), {
			keyConfig: item => item.id,
			createItem: createStore,
		})
		const amountTotal = createMemo(() =>
		items.get().reduce((sum, item) => sum + item.amount, 0))
		const priceTotal = createMemo(() =>
		items.get().reduce((sum, item) => sum + item.amount * item.pricePerUnit, 0))
		reconcile(container, host.querySelector<HTMLTemplateElement>(':scope > template[data-list="0"]')!, items, (_element, item, k, first) => {
			const input = first('input[type="text"]', 'module-calctable: input[type="text"] missing')
			const input2 = first('input.amount', 'module-calctable: input.amount missing')
			const input3 = first('input.price-per-unit', 'module-calctable: input.price-per-unit missing')
			const basicNumber = first('basic-number', 'module-calctable: basic-number missing')
			const price = createMemo(
				() => item.amount.get() * item.pricePerUnit.get(),
			)
			watch(() => item.description.get(), bindProperty(input, 'value'))
			on(input, 'input', (e: Event) => {
				item.description.set((e.target as HTMLInputElement).value)
			})
			watch(() => String(item.amount.get()), bindProperty(input2, 'value'))
			on(input2, 'input', (e: Event) => {
				item.amount.set(
					Math.min(
						100,
						Math.max(
							0,
							(e.target as HTMLInputElement).valueAsNumber || 0,
						),
					),
				)
			})
			on(input2, 'change', (e: Event) => {
				const target = e.target as HTMLInputElement
				const amount = Math.min(
					100,
					Math.max(0, target.valueAsNumber || 0),
				)
				target.value = String(amount)
				item.amount.set(amount)
				if (amount === 0) items.remove(k)
			})
			watch(() => String(item.pricePerUnit.get()), bindProperty(input3, 'value'))
			on(input3, 'input', (e: Event) => {
				item.pricePerUnit.set(
					Math.min(
						1000,
						Math.max(
							0,
							(e.target as HTMLInputElement).valueAsNumber || 0,
						),
					),
				)
			})
			on(input3, 'change', (e: Event) => {
				const target = e.target as HTMLInputElement
				const priceValue = Math.min(
					1000,
					Math.max(0, target.valueAsNumber || 0),
				)
				target.value = priceValue.toFixed(2)
				item.pricePerUnit.set(priceValue)
			})
			pass(basicNumber, { value: { get: () => price.get() } })
		})
		on(entryDescription, 'change', () => {
			const description = entryDescription.value.trim()
			const amount = clamp(entryAmount.valueAsNumber || 0, MIN_AMOUNT, MAX_AMOUNT)
			const pricePerUnit = clamp(
				entryPrice.valueAsNumber || 0,
				MIN_PRICE,
				MAX_PRICE,
			)
			if (!description || amount === 0 || pricePerUnit === 0) return
			items.add({
				id: crypto.randomUUID(),
				description,
				amount,
				pricePerUnit,
			})
			entryDescription.value = ''
			entryAmount.value = ''
			entryPrice.value = ''
			entryDescription.focus()
		})
		on(entryAmount, 'change', () => {
			const description = entryDescription.value.trim()
			const amount = clamp(entryAmount.valueAsNumber || 0, MIN_AMOUNT, MAX_AMOUNT)
			const pricePerUnit = clamp(
				entryPrice.valueAsNumber || 0,
				MIN_PRICE,
				MAX_PRICE,
			)
			if (!description || amount === 0 || pricePerUnit === 0) return
			items.add({
				id: crypto.randomUUID(),
				description,
				amount,
				pricePerUnit,
			})
			entryDescription.value = ''
			entryAmount.value = ''
			entryPrice.value = ''
			entryDescription.focus()
		})
		on(entryPrice, 'change', () => {
			const description = entryDescription.value.trim()
			const amount = clamp(entryAmount.valueAsNumber || 0, MIN_AMOUNT, MAX_AMOUNT)
			const pricePerUnit = clamp(
				entryPrice.valueAsNumber || 0,
				MIN_PRICE,
				MAX_PRICE,
			)
			if (!description || amount === 0 || pricePerUnit === 0) return
			items.add({
				id: crypto.randomUUID(),
				description,
				amount,
				pricePerUnit,
			})
			entryDescription.value = ''
			entryAmount.value = ''
			entryPrice.value = ''
			entryDescription.focus()
		})
		watch(() => amountTotal.get(), bindText(td))
		pass(basicNumber2, { value: { get: () => priceTotal.get() } })
	},
)
"
`;

exports[`variant sets — front-end parity (§4.3, ADR 0039 s1) module-cem-list client module snapshot (structural review, not bytes) 1`] = `
"/**
 * Generated by the Le Truc TSRX compiler (milestone 2) from
 * examples/module/cem-list/module-cem-list.tsx — DO NOT EDIT. The server half lives in module-cem-list.server.ts.
 */
import { defineComponent } from '@zeix/le-truc'
import { createState } from '@zeix/le-truc'

declare global {
	interface HTMLElementTagNameMap {
		'module-cem-list': HTMLElement
	}
}

/**
 * A catalog of custom-element declarations, rendered server-side from a
 * custom-elements-manifest by the \`{% cem-list %}\` Markdoc tag — the client
 * receives fully-formed \`card-collapsible\` markup and only needs to register
 * the tag name; \`card-collapsible\` and \`module-tabgroup\` provide all the
 * interactive behavior. A \`<form-textbox>\` descendant filters the cards by
 * matching its value against each card's full text content (name, tag name,
 * description, and members) — a client-side layer over pre-rendered markup,
 * no re-fetching or re-rendering involved.
 * @demo {https://zeixcom.github.io/le-truc/examples.html#module-cem-list} Interactive preview and usage examples
 **/

export default defineComponent(
	'module-cem-list',
	({ all, first, on, watch }) => {
		const filterText = createState('')
		on(first('form-textbox'), 'input', (_event, textbox) => {
			filterText.set(textbox.value.trim().toLowerCase())
		})
		watch(
			() => ({ filter: filterText.get(), cards: all('card-collapsible').get() }),
			({ filter, cards }) => {
				for (const card of cards) {
					const haystack = card.textContent?.trim().toLowerCase() ?? ''
					card.hidden = !!filter && !haystack.includes(filter)
				}
			},
		)
	},
)
"
`;

exports[`variant sets — front-end parity (§4.3, ADR 0039 s1) module-list client module snapshot (structural review, not bytes) 1`] = `
"/**
 * Generated by the Le Truc TSRX compiler (milestone 2) from
 * examples/module/list/module-list.tsx — DO NOT EDIT. The server half lives in module-list.server.ts.
 */
import { bindText, defineComponent, reconcile } from '@zeix/le-truc'
import { createList } from '@zeix/le-truc'

declare global {
	interface HTMLElementTagNameMap {
		'module-list': HTMLElement
	}
}

export default defineComponent(
	'module-list',
	({ first, host, on, pass, watch }) => {
		const container = first('ul', 'module-list: ul missing')
		const form = first('form', 'module-list: form missing')
		const textbox = first('form-textbox', 'the new-item textbox')
		const basicButton = first('basic-button.submit', 'module-list: basic-button.submit missing')
		const items = createList<string>([], {
			keyConfig: 'item',
		})
		on(form, 'submit', (e: SubmitEvent) => {
			e.preventDefault()
			const value = textbox.value.trim()
			if (!value) return
			items.add(value)
			textbox.clear()
		})
		pass(basicButton, { disabled: { get: () => !textbox.length } })
		reconcile(container, host.querySelector<HTMLTemplateElement>(':scope > template[data-list="0"]')!, items, (_element, item, k, first) => {
			const span = first('span', 'module-list: span missing')
			const button = first('button', 'module-list: button missing')
			watch(() => item.get(), bindText(span))
			on(button, 'click', () => items.remove(k))
		})
	},
)
"
`;

exports[`variant sets — front-end parity (§4.3, ADR 0039 s1) module-ticker client module snapshot (structural review, not bytes) 1`] = `
"/**
 * Generated by the Le Truc TSRX compiler (milestone 2) from
 * examples/module/ticker/module-ticker.tsx — DO NOT EDIT. The server half lives in module-ticker.server.ts.
 */
import { asString, bindAttribute, bindText, bindVisible, defineComponent, reconcile } from '@zeix/le-truc'
import type { ElementFromSelector } from '@zeix/le-truc'
import { asNumber, batch, createList, createMemo, createSensor, createState, deriveList } from '@zeix/le-truc'

export type TickerItem = {
	symbol: string
	open: number // reference price, never mutated
	price: number // current price, random-walks from open
	volume: number // cumulative volume from open
}

export type ModuleTickerProps = {
	/** Whether the ticker is actively updating prices. */
	running: boolean
	/** Fraction of symbols updated per tick (0–1). Read from the \`fraction\` attribute at connect time. */
	fraction: number
}

declare global {
	interface HTMLElementTagNameMap {
		'module-ticker': HTMLElement & ModuleTickerProps
	}
}

export default defineComponent<ModuleTickerProps>(
	'module-ticker',
	({ expose, first, host, on, pass, watch }) => {
		const container = first('table', 'module-ticker: table missing')
		const basicButton = first('basic-button.toggle', 'module-ticker: basic-button.toggle missing')
		const button = first('button.toggle', 'module-ticker: button.toggle missing')
		const button2 = first('button.add-rows', 'module-ticker: button.add-rows missing')
		const BLOCK_SIZE = 100
		const ALPHA = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
		const priceFormat = new Intl.NumberFormat('en-US', {
			minimumFractionDigits: 2,
			maximumFractionDigits: 2,
		})
		const changeFormat = new Intl.NumberFormat('en-US', {
			style: 'percent',
			minimumFractionDigits: 2,
			maximumFractionDigits: 2,
			signDisplay: 'always',
		})
		const volumeFormat = new Intl.NumberFormat('en-US', { notation: 'compact' })
		expose({
			running: true,
			fraction: asNumber(0.1),
		})
		const tickers = createList<TickerItem>([...container.children].filter(el => el.hasAttribute('data-key')).flatMap(el => [...el.children]).filter(el => el.hasAttribute('data-key')).map((el): TickerItem => ({
			symbol: asString()(el.getAttribute('data-key')),
			open: asNumber()(el.getAttribute('data-open')),
			price: asNumber()(el.querySelector<ElementFromSelector<'data.price'>>('data.price')?.value),
			volume: asNumber()(el.querySelector<ElementFromSelector<'data.volume'>>('data.volume')?.value),
		})), {
			keyConfig: item => item.symbol,
		})
		const blocks = deriveList(
			() =>
				Array.from({ length: Math.ceil(tickers.length / 100) }, (_, i) =>
					String(i),
				),
			{ keyConfig: id => id },
		)
		watch('running', running => {
			if (!running) return
			const id = setInterval(() => {
				for (const key of tickers.keys()) {
					if (Math.random() >= host.fraction) continue
					tickers.byKey(key)?.update(prev => ({
						...prev,
						price: Math.max(
							0.01,
							prev.price + (Math.random() - 0.5) * prev.price * 0.004,
						),
						volume: Math.max(0, prev.volume + Math.round(Math.random() * 50_000)),
					}))
				}
			}, 10)
			return () => clearInterval(id)
		})
		pass(basicButton, { label: { get: () => (host.running ? '⏸️ Pause' : '▶️ Resume') } })
		on(button, 'click', () => {
			host.running = !host.running
		})
		on(button2, 'click', () => {
			// One block of fresh symbols from the bijective 3-char base-26
			// counter (AAA…ZZZ), skipping symbols already listed.
			const used = new Set(tickers.keys())
			const added: TickerItem[] = []
			for (let n = 0; added.length < BLOCK_SIZE && n < 17_576; n++) {
				const symbol =
					(ALPHA[Math.floor(n / 676) % 26] ?? 'A') +
					(ALPHA[Math.floor(n / 26) % 26] ?? 'A') +
					(ALPHA[n % 26] ?? 'A')
				if (used.has(symbol)) continue
				const price =
					Math.round((10 + Math.random() * 1000) * 100) / 100
				added.push({ symbol, open: price, price, volume: 0 })
			}
			tickers.splice(tickers.length, 0, ...added)
		})
		reconcile(container, host.querySelector<HTMLTemplateElement>(':scope > template[data-list="0"]')!, blocks, (_element, _block, b, first) => {
			const tbody2 = _element as ElementFromSelector<'tbody'>
			const tr = first('tr.placeholder', 'module-ticker: tr.placeholder missing')
			const td2 = first('td.spacer', 'module-ticker: td.spacer missing')
			const start = Number(b) * BLOCK_SIZE
			const height = createState(0)
			const tbody = _element as ElementFromSelector<'tbody'>
			const visible = createSensor<boolean>(
				set => {
					const io = new IntersectionObserver(
						entries => {
							const entry = entries[0]!
							batch(() => {
								height.set(entry.boundingClientRect.height)
								set(entry.isIntersecting)
							})
						},
						{ rootMargin: '400px' },
					)
					io.observe(tbody)
					return () => io.disconnect()
				},
				{ value: true }, // visible until the first callback corrects it
			)
			const symbols = deriveList(
				() =>
					visible.get()
						? [...tickers.keys()].slice(start, start + BLOCK_SIZE)
						: [],
				{ keyConfig: symbol => symbol },
			)
			reconcile(tbody2, host.querySelector<HTMLTemplateElement>(':scope > template[data-list="1"]')!, symbols, (_element, _symbol, s, first) => {
				const tr2 = _element as ElementFromSelector<'tr'>
				const th = first('th', 'module-ticker: th missing')
				const data = first('data.price', 'module-ticker: data.price missing')
				const td = first('td.change', 'module-ticker: td.change missing')
				const data2 = first('data.volume', 'module-ticker: data.volume missing')
				const ticker = tickers.byKey(s)!
				const change = createMemo(() => {
					const { open, price } = ticker.get()
					return (price - open) / open
				})
				const priceText = createMemo(() =>
					priceFormat.format(ticker.get().price),
				)
				const changeText = createMemo(() =>
					changeFormat.format(change.get()),
				)
				const volumeText = createMemo(() =>
					volumeFormat.format(ticker.get().volume),
				)
				watch(() => String(ticker.get().open), bindAttribute(tr2, 'data-open'))
				watch(() => {
					const c = change.get()
					return c > 0 ? 'up' : c < 0 ? 'down' : 'flat'
				}, bindAttribute(tr2, 'data-direction'))
				watch(() => ticker.get().symbol, bindText(th))
				watch(() => String(ticker.get().price), bindAttribute(data, 'value'))
				watch(() => priceText.get(), bindText(data))
				watch(() => changeText.get(), bindText(td))
				watch(() => String(ticker.get().volume), bindAttribute(data2, 'value'))
				watch(() => volumeText.get(), bindText(data2))
			})
			watch(() => symbols.length === 0, bindVisible(tr))
			watch(() =>
			\`height:\${height.get()}px;padding:0;border:none\`, bindAttribute(td2, 'style'))
		})
	},
)
"
`;

