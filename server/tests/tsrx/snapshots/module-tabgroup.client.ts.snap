import { bindAttribute, createCell, defineComponent, each } from '@zeix/le-truc'

export type ModuleTabgroupProps = {
	/** The `aria-controls` value of the currently selected tab (read-only). */
	readonly selected: string
}

export type ModuleTabgroupTab = {
	id: string
	label: string
	content: string
}

declare global {
	interface HTMLElementTagNameMap {
		'module-tabgroup': HTMLElement & ModuleTabgroupProps
	}
}

/**
 * An accessible tab group with keyboard navigation (Arrow, Home, End keys) and reactive panel switching.
 * Use it for tabbed interfaces — provides ARIA tab/tabpanel semantics, focus management
 * with roving tabindex, and keyboard accessibility per the WAI-ARIA tabs pattern.
 * @demo {https://zeixcom.github.io/le-truc/examples.html#module-tabgroup} Interactive preview and usage examples
 **/

export default defineComponent<ModuleTabgroupProps>(
	'module-tabgroup',
	({ all, expose, on, watch }) => {
		const tabs = all('button[role="tab"]', 'module-tabgroup: button[role="tab"] missing')
		const tabpanels = all('[role="tabpanel"]', 'module-tabgroup: [role="tabpanel"] missing')
		const selected = createCell(tabs.get().find(el => el.ariaSelected === 'true')?.getAttribute('aria-controls') ?? '')
		expose({ selected: selected.get })
		each(tabs, tab => {
			const pid = tab.getAttribute('aria-controls')!
			watch(() => String(selected.get() === pid), bindAttribute(tab, 'aria-selected'))
			watch(() => String((() => (selected.get() === pid ? 0 : -1))()), bindAttribute(tab, 'tabindex'))
			on(tab, 'click', () => selected.set(pid))
			on(tab, 'keyup', (e: KeyboardEvent) => {
				if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key)) return
				e.preventDefault()
				e.stopPropagation()
				// written DOM-relative: sibling tabs and their
				// aria-controls values — no server data needed
				const tablist = (e.currentTarget as HTMLElement).closest('[role="tablist"]')!
				const siblings = [...tablist.querySelectorAll<HTMLButtonElement>('button[role="tab"]')]
				const current = siblings.indexOf(e.currentTarget as HTMLButtonElement)
				const offset = e.key === 'Home'
					? -current
					: e.key === 'End'
						? siblings.length - 1 - current
						: e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 1
				const next = siblings[(current + offset + siblings.length) % siblings.length]!
				next.focus()
				selected.set(next.getAttribute('aria-controls')!)
			})
		})
		each(tabpanels, tab => {
			const pid = tab.id
			watch(() => selected.get() !== pid, bindAttribute(tab, 'hidden'))
		})
	},
)
